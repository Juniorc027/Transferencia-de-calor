<?xml version="1.0" encoding="utf-8"?>
<!--
  Projeto console SEPARADO do simulador (estilo antigo, .NET Framework 4.8).
  Ele NAO é referenciado pelo csproj principal, e o csproj principal lista os
  arquivos um a um (<Compile Include=...>), então esta pasta não entra na entrega.
  Só os fontes que não dependem de WinForms são vinculados ("Add as Link"):
  Models, Estrutura, Data e Simulation. Assim o benchmark mede exatamente o
  código do simulador, sem cópia.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7B1D3C52-9A44-4E0B-8F2A-5C6E1D0A9B31}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>TransferenciaCalor.Benchmark</RootNamespace>
    <AssemblyName>BenchmarkSimulador</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- Sem "Prefer 32-bit": em Windows 64 bits o processo roda como x64 -->
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Management" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Estrutura\No.cs"><Link>Fontes\Estrutura\No.cs</Link></Compile>
    <Compile Include="..\Estrutura\ListaEncadeada.cs"><Link>Fontes\Estrutura\ListaEncadeada.cs</Link></Compile>
    <Compile Include="..\Models\Material.cs"><Link>Fontes\Models\Material.cs</Link></Compile>
    <Compile Include="..\Models\Body.cs"><Link>Fontes\Models\Body.cs</Link></Compile>
    <Compile Include="..\Data\MaterialCatalog.cs"><Link>Fontes\Data\MaterialCatalog.cs</Link></Compile>
    <Compile Include="..\Simulation\HeatGrid.cs"><Link>Fontes\Simulation\HeatGrid.cs</Link></Compile>
    <Compile Include="..\Simulation\HeatSimulationEngine.cs"><Link>Fontes\Simulation\HeatSimulationEngine.cs</Link></Compile>
    <Compile Include="..\Simulation\IMotorSimulacao.cs"><Link>Fontes\Simulation\IMotorSimulacao.cs</Link></Compile>
    <Compile Include="..\Simulation\HeatSimulationEngineParalelo.cs"><Link>Fontes\Simulation\HeatSimulationEngineParalelo.cs</Link></Compile>
    <Compile Include="..\Persistencia\ModelosPersistencia.cs"><Link>Fontes\Persistencia\ModelosPersistencia.cs</Link></Compile>
    <Compile Include="..\Persistencia\IRepositorioSimulacao.cs"><Link>Fontes\Persistencia\IRepositorioSimulacao.cs</Link></Compile>
    <Compile Include="..\Persistencia\RepositorioMySql.cs"><Link>Fontes\Persistencia\RepositorioMySql.cs</Link></Compile>
    <Compile Include="..\Persistencia\GravadorSimulacao.cs"><Link>Fontes\Persistencia\GravadorSimulacao.cs</Link></Compile>
    <Compile Include="..\Persistencia\SessaoGravacao.cs"><Link>Fontes\Persistencia\SessaoGravacao.cs</Link></Compile>
    <Compile Include="..\Persistencia\ExecutorSimulacao.cs"><Link>Fontes\Persistencia\ExecutorSimulacao.cs</Link></Compile>
    <Compile Include="..\Persistencia\ConfiguracaoBanco.cs"><Link>Fontes\Persistencia\ConfiguracaoBanco.cs</Link></Compile>
    <EmbeddedResource Include="..\Persistencia\schema.sql"><LogicalName>schema.sql</LogicalName><Link>Fontes\Persistencia\schema.sql</Link></EmbeddedResource>
    <Compile Include="RepositorioEmMemoria.cs" />
    <Compile Include="VerificacaoGravacao.cs" />
    <Compile Include="BenchBanco.cs" />
    <Compile Include="DiagnosticoEquilibrio.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Verificacao.cs" />
    <Compile Include="BenchMotores.cs" />
    <Compile Include="Medicao.cs" />
    <Compile Include="Cenarios.cs" />
    <Compile Include="Ambiente.cs" />
    <Compile Include="Relatorio.cs" />
  </ItemGroup>
  <ItemGroup>
